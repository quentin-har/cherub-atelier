# Sanity configuration — set these in Netlify's Environment Variables dashboard
# NEVER commit an actual .env file. This file (.env.example) is safe to commit
# because it contains no real values.
#
# Phase 4: copy these key names into Netlify → Site settings → Environment variables
# and paste the real values there.

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
